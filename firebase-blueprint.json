{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "Collection of all registered users in MKVERSE",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "displayNameLower": { "type": "string" },
        "username": { "type": "string" },
        "usernameLower": { "type": "string" },
        "photoURL": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "role": { "type": "string" },
        "userType": { "type": "string" },
        "accountStatus": { "type": "string" },
        "status": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "username", "role", "accountStatus"]
    },
    "posts": {
      "title": "Posts",
      "description": "Feed posts and confessions",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorId", "content"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "System and social notifications",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message"]
    }
  }
}
